{
	"name": "unspoon",
	"private": true,
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": ">=24.21.0 <25",
		"pnpm": "12.8.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "24.19.1",
		"typescript": "6.0.3"
	},
	"scripts": {
		"typecheck": "pnpm -r --if-present run typecheck",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "pnpm -r --if-present run test",
		"check": "node scripts/check-node.mjs && pnpm lint && pnpm typecheck && pnpm test"
	}
}
